;; ---------------------------------------------------------------------------
;; Shared overlay applied to every Safehouse-wrapped agent (--append-profile).
;; ---------------------------------------------------------------------------

(allow file-read*
    (subpath "/Library/Developer/Toolchains")
    (home-literal "/Library/Developer")
    (home-subpath "/Library/Developer/Toolchains")
)

(allow file-read*
    (subpath "/Library/TeX")
    (subpath "/usr/local/texlive")
)

;; Private dotfiles must never be visible, regardless of workdir grants.
(deny file-read* file-write*
    (home-subpath "/.dotfiles_private")
)
