;; ---------------------------------------------------------------------------
;; Integration: OpenCL on macOS (cl2Metal JIT)
;;
;; Apple's OpenCL runtime compiles kernels to Metal at clBuildProgram /
;; clCreateKernel time through the cl2Metal translator. That path differs
;; from plain Metal/MPS in three ways, all default-denied by the base policy:
;;
;;   1. mach-lookup on the Metal frontend and GPU binary-archive services
;;      (com.apple.metalfe / com.apple.gpuarchiver). The gpu integration only
;;      grants com.apple.MTLCompilerService, which cl2Metal does not use.
;;   2. file-issue-extension: the frameworks mint sandbox extension tokens
;;      for the shader-cache paths via sandbox_extension_issue_file().
;;      Directory grants alone cannot fix this denial.
;;   3. file access to the per-user shader caches under ~/Library/Caches.
;;      (The /var/folders cache roots are already writable via the base
;;      temp-dir grant.)
;;
;; Appended for every wrapped command alongside --enable=gpu; these grants
;; are meaningless without the GPU IOKit clients that integration provides.
;; CPU OpenCL devices work without this overlay.
;; ---------------------------------------------------------------------------

(allow mach-lookup
    ;; metalfe is probed both as a global mach name and as a bundled XPC
    ;; service depending on the caller; grant both lookup forms.
    (global-name "com.apple.metalfe")
    (xpc-service-name "com.apple.metalfe")
    (global-name "com.apple.gpuarchiver")
)

;; Frameworks call sandbox_extension_issue_file() for the cache paths below;
;; stays default-denied without this. Blanket grant for the extension
;; family; tighten with (extension-class ...) once real denials are known.
(allow file-issue-extension*)

;; Per-user Metal shader cache and GPU binary archives in the home dir.
(allow file-read* file-write*
    (home-subpath "/Library/Caches/com.apple.metal")
    (home-subpath "/Library/Caches/com.apple.gpuarchiver")
)
