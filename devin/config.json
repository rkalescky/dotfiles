{
  // Merged into ~/.config/devin/config.json by devin/sync_config.py.
  // Keys here win over local values; local-only keys are preserved.

  // Run sessions inside each `devin` process instead of the shared
  // background daemon (daemon is the default since v3000.13).
  "process_model": "in-process",

  // Supervised default for unwrapped invocations (`command devin`,
  // editor-spawned `devin acp`): shell commands and writes prompt.
  // The fish Safehouse wrapper passes --permission-mode dangerous per
  // launch, so wrapped sessions still run unattended inside the
  // sandbox, which is the containment boundary.
  "permission_mode": "normal",

  "permissions": {
    "allow": [
      // Unioned into the local allow list, never replacing it.
      // Curated read-only commands only — the blanket "exec" and
      // "mcp__*" entries must be removed from the local config once
      // by hand, since sync never subtracts entries.
      "Exec(git status)",
      "Exec(git diff)",
      "Exec(git log)",
      "Exec(git show)",
      "Exec(git remote)",
      "Exec(git fetch)",
      "Exec(wc)",
      "Exec(grep)",
      "Exec(sed)",
      "Exec(ls)"
    ]
  }
}
